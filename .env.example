# Copia este archivo a `.env` y rellena tus claves reales.
# El archivo `.env` está en .gitignore y NUNCA se sube al repositorio.

# Clave de API de Pinecone (https://app.pinecone.io -> API Keys)
PINECONE_API_KEY=pcsk_tu_clave_de_pinecone_aqui

# Clave de API de OpenAI, para generar los embeddings de la consulta
OPENAI_API_KEY=sk-proj-tu_clave_de_openai_aqui

# Modelo de embeddings. Debe coincidir con la dimension del indice de Pinecone
# (text-embedding-3-large = 3072 dim).
EMBED_MODEL=text-embedding-3-large
