# Copia este archivo a `.env` y rellena tus valores. `.env` está en .gitignore
# y NUNCA se sube al repositorio.

# ===== Obligatorias (SOLO necesitas estas) =====

# Tu clave de API de Pinecone (https://app.pinecone.io -> API Keys)
PINECONE_API_KEY=pcsk_tu_clave_de_pinecone

# Nombre del índice de Pinecone donde buscar por defecto
PINECONE_INDEX=mi-indice

# ===== Opcionales =====

# Modelo de embebido (cómo se convierte la consulta en vector).
# Debe COINCIDIR con el modelo con el que se creó el índice.
#  - Si lo dejas vacío y NO usas OpenAI: Pinecone usa `multilingual-e5-large`
#    (1024 dim) con tu sola clave de Pinecone. No hace falta nada más.
#  - Otros modelos de Pinecone: `llama-text-embed-v2`, `multilingual-e5-large`...
#  - Modelos de OpenAI (requieren OPENAI_API_KEY): `text-embedding-3-large`
#    (3072), `text-embedding-3-small` (1536).
EMBED_MODEL=

# Clave de OpenAI. SOLO necesaria si tu índice se creó con embeddings de OpenAI
# (EMBED_MODEL = text-embedding-*). Si no, déjala vacía: no se usa.
OPENAI_API_KEY=

# Namespace por defecto de Pinecone (vacío si no usas namespaces)
PINECONE_NAMESPACE=

# Campo de metadata con el texto del documento (si vacío, se autodetecta)
TEXT_FIELD=

# Alias de índices en JSON, p. ej. {"docs":"mi-indice-docs"}
PINECONE_INDEX_ALIASES=
