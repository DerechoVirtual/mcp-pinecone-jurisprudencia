# Copia este archivo a `.env` y rellena tus valores. `.env` está en .gitignore
# y NUNCA se sube al repositorio.

# --- Obligatorias ---

# Tu clave de API de Pinecone (https://app.pinecone.io -> API Keys)
PINECONE_API_KEY=pcsk_tu_clave_de_pinecone

# Tu clave de API de OpenAI (se usa para embeber la consulta)
OPENAI_API_KEY=sk-proj-tu_clave_de_openai

# Nombre del índice de Pinecone donde buscar por defecto
PINECONE_INDEX=mi-indice

# --- Opcionales ---

# Modelo de embeddings. DEBE coincidir con la dimensión del índice:
#   text-embedding-3-large = 3072 dim
#   text-embedding-3-small = 1536 dim
EMBED_MODEL=text-embedding-3-large

# Namespace por defecto de Pinecone (déjalo vacío si no usas namespaces)
PINECONE_NAMESPACE=

# Campo de metadata que contiene el texto del documento. Si lo dejas vacío, el
# servidor prueba nombres comunes (text, texto, content, chunk_text, ...).
TEXT_FIELD=

# Alias de índices en JSON, para poder pasar nombres cortos al buscar.
# Ej.: PINECONE_INDEX_ALIASES={"familia":"jurisprudencia-derecho-familia","lec":"lec-espana"}
PINECONE_INDEX_ALIASES=
